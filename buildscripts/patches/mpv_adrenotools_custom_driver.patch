diff --git a/video/out/vulkan/context.c b/video/out/vulkan/context.c
index 26194a83c1..f9fbd4124d 100644
--- a/video/out/vulkan/context.c
+++ b/video/out/vulkan/context.c
@@ -176,8 +176,12 @@ static void ra_vk_ctx_destroy_surface(struct mpvk_ctx *vk)
 {
     if (vk->swapchain)
         pl_swapchain_destroy(&vk->swapchain);
-    if (vk->surface != VK_NULL_HANDLE)
-        vkDestroySurfaceKHR(vk->vkinst->instance, vk->surface, NULL);
+    if (vk->surface != VK_NULL_HANDLE) {
+        PFN_vkDestroySurfaceKHR pfnDestroy = (PFN_vkDestroySurfaceKHR)
+            vk->vkinst->get_proc_addr(vk->vkinst->instance, "vkDestroySurfaceKHR");
+        if (pfnDestroy)
+            pfnDestroy(vk->vkinst->instance, vk->surface, NULL);
+    }
     vk->surface = VK_NULL_HANDLE;
 }
 
diff --git a/video/out/vulkan/context_android.c b/video/out/vulkan/context_android.c
index 04cffba9f8..2899a92243 100644
--- a/video/out/vulkan/context_android.c
+++ b/video/out/vulkan/context_android.c
@@ -44,8 +44,13 @@ static VkSurfaceKHR android_create_surface(struct ra_ctx *ctx,
     };
 
     VkSurfaceKHR surface = VK_NULL_HANDLE;
-    VkResult res = vkCreateAndroidSurfaceKHR(vk->vkinst->instance, &info,
-                                             NULL, &surface);
+    PFN_vkCreateAndroidSurfaceKHR pfnCreateSurface = (PFN_vkCreateAndroidSurfaceKHR)
+        vk->vkinst->get_proc_addr(vk->vkinst->instance, "vkCreateAndroidSurfaceKHR");
+    if (!pfnCreateSurface) {
+        MP_MSG(ctx, msgl, "vkCreateAndroidSurfaceKHR not found in instance\n");
+        return VK_NULL_HANDLE;
+    }
+    VkResult res = pfnCreateSurface(vk->vkinst->instance, &info, NULL, &surface);
     if (res != VK_SUCCESS) {
         MP_MSG(ctx, msgl, "Failed creating Android surface\n");
         return VK_NULL_HANDLE;
@@ -153,7 +158,10 @@ static bool android_update_window(struct ra_ctx *ctx)
         goto fail;
 
     if (!ra_vk_ctx_replace_surface(ctx, surface, VK_PRESENT_MODE_FIFO_KHR)) {
-        vkDestroySurfaceKHR(vk->vkinst->instance, surface, NULL);
+        PFN_vkDestroySurfaceKHR pfnDestroy = (PFN_vkDestroySurfaceKHR)
+            vk->vkinst->get_proc_addr(vk->vkinst->instance, "vkDestroySurfaceKHR");
+        if (pfnDestroy)
+            pfnDestroy(vk->vkinst->instance, surface, NULL);
         goto fail;
     }
 
