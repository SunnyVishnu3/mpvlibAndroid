+                float lobe_scale = MPCLAMP(p_clamped * 0.2f, 0.0f, 1.0f);
+                float usm_str   = p_clamped * 0.3f;
+                float dk_str    = p_clamped * 0.12f;
+                snprintf(shader, sizeof(shader),
+                    "//!HOOK OUTPUT\n"
+                    "//!BIND HOOKED\n"
+                    "//!DESC sharpen (9-tap RCAS+USM+VD, param=%.4f)\n"
+                    "vec4 hook() {\n"
+                    "    mediump vec4 base = HOOKED_tex(HOOKED_pos);\n"
+                    "    mediump vec4 tc   = HOOKED_texOff(vec2( 0.0, -1.0));\n"
+                    "    mediump vec4 ml   = HOOKED_texOff(vec2(-1.0,  0.0));\n"
+                    "    mediump vec4 mr   = HOOKED_texOff(vec2( 1.0,  0.0));\n"
+                    "    mediump vec4 bc   = HOOKED_texOff(vec2( 0.0,  1.0));\n"
+                    "    mediump vec4 tl   = HOOKED_texOff(vec2(-1.0, -1.0));\n"
+                    "    mediump vec4 tr   = HOOKED_texOff(vec2( 1.0, -1.0));\n"
+                    "    mediump vec4 bl   = HOOKED_texOff(vec2(-1.0,  1.0));\n"
+                    "    mediump vec4 br   = HOOKED_texOff(vec2( 1.0,  1.0));\n"
+                    "    const highp vec3 lc = vec3(0.299, 0.587, 0.114);\n"
+                    "    highp float e  = dot(base.rgb, lc);\n"
+                    "    highp float b  = dot(tc.rgb,   lc);\n"
+                    "    highp float d  = dot(ml.rgb,   lc);\n"
+                    "    highp float f  = dot(mr.rgb,   lc);\n"
+                    "    highp float h  = dot(bc.rgb,   lc);\n"
+                    "    highp float g1 = dot(tl.rgb,   lc);\n"
+                    "    highp float g2 = dot(tr.rgb,   lc);\n"
+                    "    highp float g3 = dot(bl.rgb,   lc);\n"
+                    "    highp float g4 = dot(br.rgb,   lc);\n"
+                    "    highp float mn_c = min(min(b,d),min(f,h));\n"
+                    "    highp float mx_c = max(max(b,d),max(f,h));\n"
+                    "    highp float mn_d = min(min(g1,g2),min(g3,g4));\n"
+                    "    highp float mx_d = max(max(g1,g2),max(g3,g4));\n"
+                    "    highp float mn1  = min(mn_c,mn_d);\n"
+                    "    highp float mx1  = max(mx_c,mx_d);\n"
+                    "    highp float hitMinL = min(mn1,e)/(6.0*mx1+1e-5);\n"
+                    "    highp float hitMaxL = (1.0-max(mx1,e))/(6.0*mn1-6.0+1e-5);\n"
+                    "    highp float lobeL   = max(-hitMinL,hitMaxL);\n"
+                    "    highp float lobe = max(-0.125, min(lobeL,0.0)) * %.6f;\n"
+                    "    highp float avg8 = (b+d+f+h+g1+g2+g3+g4)*0.125;\n"
+                    "    highp float nz = avg8 - e;\n"
+                    "    highp float nz_range = mx1 - mn1;\n"
+                    "    nz = clamp(abs(nz)/(nz_range+1e-5),0.0,1.0);\n"
+                    "    nz = -0.5*nz+1.0;\n"
+                    "    lobe *= nz;\n"
+                    "    mediump float rcpL = float(1.0/(6.0*lobe+1.0));\n"
+                    "    mediump vec3 card_sum = tc.rgb+ml.rgb+mr.rgb+bc.rgb;\n"
+                    "    mediump vec3 diag_sum = tl.rgb+tr.rgb+bl.rgb+br.rgb;\n"
+                    "    mediump vec4 color;\n"
+                    "    color.rgb = clamp((float(lobe)*(card_sum+0.5*diag_sum)+base.rgb)*rcpL,0.0,1.0);\n"
+                    "    highp float blur9 = (b+d+f+h+g1+g2+g3+g4+e)*(1.0/9.0);\n"
