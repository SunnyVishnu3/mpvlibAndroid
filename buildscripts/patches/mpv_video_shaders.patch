diff --git a/video/csputils.c b/video/csputils.c
index 0b000a9..8ab9f17 100644
--- a/video/csputils.c
+++ b/video/csputils.c
@@ -384,6 +384,56 @@ void mp_get_csp_matrix(struct mp_csp_params *params, struct pl_transform3x3 *m)
             m->mat.m[i][1] = huecos * u - huesin * v;
             m->mat.m[i][2] = huesin * u + huecos * v;
         }
+    } else if (colorspace == PL_COLOR_SYSTEM_RGB && !params->gray &&
+               (params->saturation != 1 || params->hue != 0)) {
+        // The source is already RGB (e.g. the Android MediaCodec hardware
+        // decoder, whose output surface yields RGB), so saturation and hue
+        // would normally be silently ignored: they are only ever folded into a
+        // YUV->RGB conversion matrix, which does not exist for RGB input.
+        // (Brightness and contrast still work above because they are a plain
+        // scale+offset that is valid in any colorspace.)
+        //
+        // Apply sat/hue here by round-tripping through a YCbCr representation:
+        //   m_rgb = (Yuv2Rgb with sat/hue) * inverse(Yuv2Rgb)
+        // i.e. rgb -> yuv, scale/rotate the chroma exactly as the YUV branch
+        // above does, then yuv -> rgb. BT.709 luma weights are used since that
+        // is the standard for the HD/4K content these hardware surfaces carry.
+        // The uniform contrast scale and brightness offset applied below commute
+        // with this matrix (for RGB, levels_in == -1 makes ymul == cmul), so the
+        // existing brightness/contrast behaviour is preserved.
+        float huecos = params->saturation * cos(params->hue);
+        float huesin = params->saturation * sin(params->hue);
+        
+        // YUV to RGB (BT.709)
+        float Y00 = 1.0f, Y01 = 0.0f,       Y02 = 1.5748f;
+        float Y10 = 1.0f, Y11 = -0.187327f, Y12 = -0.468124f;
+        float Y20 = 1.0f, Y21 = 1.8556f,    Y22 = 0.0f;
+        
+        // RGB to YUV (BT.709 inverse)
+        float I00 = 0.2126f,    I01 = 0.7152f,    I02 = 0.0722f;
+        float I10 = -0.114572f, I11 = -0.385428f, I12 = 0.5000f;
+        float I20 = 0.5000f,    I21 = -0.454153f, I22 = -0.045847f;
+
+        // Apply hue/saturation to U and V columns of YUV2RGB
+        float T01 = Y01 * huecos - Y02 * huesin;
+        float T02 = Y01 * huesin + Y02 * huecos;
+        float T11 = Y11 * huecos - Y12 * huesin;
+        float T12 = Y11 * huesin + Y12 * huecos;
+        float T21 = Y21 * huecos - Y22 * huesin;
+        float T22 = Y21 * huesin + Y22 * huecos;
+
+        // Final matrix = (Y * H) * I
+        m->mat.m[0][0] = Y00 * I00 + T01 * I10 + T02 * I20;
+        m->mat.m[0][1] = Y00 * I01 + T01 * I11 + T02 * I21;
+        m->mat.m[0][2] = Y00 * I02 + T01 * I12 + T02 * I22;
+
+        m->mat.m[1][0] = Y10 * I00 + T11 * I10 + T12 * I20;
+        m->mat.m[1][1] = Y10 * I01 + T11 * I11 + T12 * I21;
+        m->mat.m[1][2] = Y10 * I02 + T11 * I12 + T12 * I22;
+
+        m->mat.m[2][0] = Y20 * I00 + T21 * I10 + T22 * I20;
+        m->mat.m[2][1] = Y20 * I01 + T21 * I11 + T22 * I21;
+        m->mat.m[2][2] = Y20 * I02 + T21 * I12 + T22 * I22;
     }
 
